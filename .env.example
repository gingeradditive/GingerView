# GingerView — development overrides
#
# Copy to .env and set your printer's address:  cp .env.example .env
#
# You do NOT need this file to run GingerView on a printer. By default the app
# talks to Moonraker on its own origin, with nginx proxying /printer/, /server/,
# /machine/, /access/, /api/ and /websocket. These variables exist for development,
# when the Vite dev server and the printer are different hosts.
#
# Two things to know:
#   - Values are inlined at BUILD time. Editing this file does nothing to an
#     already-installed machine — you have to rebuild and redeploy.
#   - They end up readable inside the bundle. Never put secrets here.
#
# Every key below is actually read by src/lib/services/config.ts. Precedence is:
# explicit URL  >  HOST + PORT  >  same origin.


# ── Moonraker ────────────────────────────────────────────────────────────────

# Printer address. This is the switch: set it and the app stops using its own
# origin and starts calling this host directly. Leave it out for same-origin.
VITE_MOONRAKER_HOST=192.168.1.147

# Moonraker's port. Only read when VITE_MOONRAKER_HOST is set.
VITE_MOONRAKER_PORT=7125

# Full HTTP base URL, overriding HOST/PORT above. For when Moonraker sits behind
# a proxy on a path or a non-standard scheme.
# VITE_MOONRAKER_API_URL=http://192.168.1.147:7125

# Full WebSocket URL, overriding HOST/PORT above. Must include /websocket.
# VITE_MOONRAKER_WS_URL=ws://192.168.1.147:7125/websocket


# ── G2-Service ───────────────────────────────────────────────────────────────
# The host's own API — network and timezone — separate from Moonraker and served
# under /service/. Used by Settings → Network and Settings → Timezone.

# Its address. Defaults to VITE_MOONRAKER_HOST, so usually you can leave it out.
# VITE_G2_SERVICE_HOST=192.168.1.147

# Its port. Only read when a host is set, whether here or inherited above.
# VITE_G2_SERVICE_PORT=8000

# Full base URL, overriding host/port above. Without the /service prefix: that
# is part of the contract and the client adds it.
# VITE_G2_SERVICE_BASE_URL=http://192.168.1.147:8000


# Reminder: with these set, the browser makes cross-origin requests, so the dev
# server origin (http://localhost:5173) must be listed under cors_domains in
# moonraker.conf. See docs/03-configurazione.md.
