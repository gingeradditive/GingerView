# GingerView — development overrides
#
# You do NOT need this file to run GingerView on a printer.
#
# By default the app talks to Moonraker on its own origin: nginx serves the build
# on port 80 and proxies /printer/, /server/, /machine/, /access/, /api/ and
# /websocket to Moonraker. That is what lets a browser — and GingerSlicer — reach
# the printer without naming a port, and it means the compiled bundle contains no
# addresses at all, so a single build works on every machine.
#
# These variables exist for development, when the Vite dev server and the printer
# are different hosts. They are inlined at BUILD time, so setting them here has no
# effect on an already-installed machine: you would have to rebuild and redeploy.
#
# Copy to .env and set the address of your printer.

# --- Moonraker --------------------------------------------------------------
# Setting the host switches the app from same-origin to absolute URLs.
VITE_MOONRAKER_HOST=192.168.1.147
VITE_MOONRAKER_PORT=7125

# Optional: full URLs, taking precedence over the host/port above.
# VITE_MOONRAKER_WS_URL=ws://192.168.1.147:7125/websocket
# VITE_MOONRAKER_API_URL=http://192.168.1.147:7125

# Optional: name shown in the interface.
VITE_PRINTER_NAME=Ginger Printer

# Optional: connection timeout in milliseconds.
VITE_CONNECTION_TIMEOUT=5000

# --- Wi-Fi service ----------------------------------------------------------
# A separate service, not Moonraker. Defaults to the Moonraker host on port 8000.
# VITE_NETWORK_API_HOST=192.168.1.147
# VITE_NETWORK_API_PORT=8000

# Optional: full base URL, taking precedence over the host/port above.
# VITE_NETWORK_API_BASE_URL=http://192.168.1.147:8000

# Remember to add the dev server origin (http://localhost:5173) to cors_domains
# in moonraker.conf, or the browser will block these cross-origin requests.
